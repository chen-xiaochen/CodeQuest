<idea-plugin>
    <id>com.codequest</id>
    <name>CodeQuest</name>
    <vendor>CodeQuest Team</vendor>
    <description><![CDATA[
    CodeQuest is a competitive programming assistant for JetBrains IDEs.
    Query problems, browse statements, submit solutions and track statistics
    across LeetCode, LeetCode CN, CodeForces, AtCoder, Luogu and HackerRank.
    ]]></description>

    <!-- 1.1.0:原版设计对齐九项(详情/状态列/账号/模板/CSS/回看/排序/缩放/公司题);详见 CHANGELOG.md -->
    <change-notes><![CDATA[
    1.1.0 — legacy-parity release: submission result details (LeetCode/CN error test
    cases) with code review tabs, problem status column (AC/tried/paid) with local
    filtering, account menu with logout, per-language code templates and custom CSS,
    solution ordering dropdown, webview zoom toolbar, and LeetCode company question
    lists. Browse flows also gained a login entry and LeetCode CN shows Chinese
    titles again. See CHANGELOG.md for details.
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <!-- 2026.2 起 JCEF 从 IntelliJ Platform 拆为独立模块(发行版 plugins/jcef-plugin,
         <id>com.intellij.modules.jcef</id>,已实测);未声明会导致运行时 NoClassDefFoundError -->
    <depends>com.intellij.modules.jcef</depends>

    <!-- WP21:plugin.xml 内 %key% 本地化(action 菜单文案)统一指向 PluginBundle -->
    <resource-bundle>messages.PluginBundle</resource-bundle>

    <idea-version since-build="262"/>

    <!-- WP17:OJ 平台能力 SPI 注册点。新增 OJ = platform/<oj> 包 + 此处一行
         <ojPlatformProvider implementation="..."/> 声明(经 OJPlatformRegistry 查询) -->
    <extensionPoints>
        <extensionPoint qualifiedName="com.codequest.ojPlatformProvider"
                        interface="com.codequest.spi.OJPlatformProvider"
                        dynamic="true"/>
        <!-- WP19:传输层/凭据存储的 SPI→infra 注入点(platform 包不 import infra) -->
        <extensionPoint qualifiedName="com.codequest.ojTransportProvider"
                        interface="com.codequest.spi.OJTransportProvider"
                        dynamic="true"/>
        <extensionPoint qualifiedName="com.codequest.ojCredentialStoreProvider"
                        interface="com.codequest.spi.OJCredentialStoreProvider"
                        dynamic="true"/>
        <!-- WP23:交互登录装配(SubmissionPlatforms 经此解析,消灭按平台 id 的 when);
             anti-bot 人机验证处理器(JCEF Turnstile 弹窗,平台零 UI 依赖) -->
        <extensionPoint qualifiedName="com.codequest.ojAuthPromptProvider"
                        interface="com.codequest.spi.OJAuthPromptProvider"
                        dynamic="true"/>
        <extensionPoint qualifiedName="com.codequest.antiBotHandlerProvider"
                        interface="com.codequest.spi.AntiBotChallengeHandlerProvider"
                        dynamic="true"/>
        <!-- WP38:账号状态数据源注入(ui 提交链路缓存实例 → infra /api/auth/status,
             与 ojTransportProvider 同为反转注入点,infra 不反向依赖 ui) -->
        <extensionPoint qualifiedName="com.codequest.authPlatformSourceProvider"
                        interface="com.codequest.infra.messaging.AuthPlatformSourceProvider"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.codequest">
        <!-- WP19:LeetCode / 力扣CN 平台适配器 -->
        <ojPlatformProvider implementation="com.codequest.platform.leetcode.LeetCodeProvider"/>
        <ojPlatformProvider implementation="com.codequest.platform.leetcode.LeetCodeCnProvider"/>
        <!-- WP24:CodeForces 平台适配器(含竞赛能力) -->
        <ojPlatformProvider implementation="com.codequest.platform.codeforces.CodeForcesProvider"/>
        <!-- WP25:AtCoder 平台适配器(Turnstile 提交) -->
        <ojPlatformProvider implementation="com.codequest.platform.atcoder.AtCoderProvider"/>
        <!-- WP26:洛谷平台适配器(题解列表) -->
        <ojPlatformProvider implementation="com.codequest.platform.luogu.LuoguProvider"/>
        <!-- WP27:HackerRank 平台适配器(M4 收官) -->
        <ojPlatformProvider implementation="com.codequest.platform.hackerrank.HackerRankProvider"/>
        <!-- WP19:SPI 传输/凭据接口的生产实现(均在 infra,经 EP 注入) -->
        <ojTransportProvider implementation="com.codequest.infra.http.HttpOJTransportProvider"/>
        <ojCredentialStoreProvider implementation="com.codequest.infra.secrets.SecretsStoreCredentialStoreProvider"/>
        <!-- WP23:交互登录装配实现(LeetCode cookie 对话框)+ 反爬 JCEF 弹窗处理器 -->
        <ojAuthPromptProvider implementation="com.codequest.ui.submission.LeetCodeAuthPromptProvider"/>
        <!-- WP24:CodeForces cookie 粘贴登录装配 -->
        <ojAuthPromptProvider implementation="com.codequest.ui.submission.CodeForcesAuthPromptProvider"/>
        <!-- WP25:AtCoder cookie 粘贴登录装配 -->
        <ojAuthPromptProvider implementation="com.codequest.ui.submission.AtCoderAuthPromptProvider"/>
        <!-- WP26:洛谷 cookie 粘贴登录装配 -->
        <ojAuthPromptProvider implementation="com.codequest.ui.submission.LuoguAuthPromptProvider"/>
        <!-- WP27:HackerRank cookie 粘贴登录装配 -->
        <ojAuthPromptProvider implementation="com.codequest.ui.submission.HackerRankAuthPromptProvider"/>
        <antiBotHandlerProvider implementation="com.codequest.ui.antibot.JcefAntiBotChallengeHandlerProvider"/>
        <!-- WP38:账号状态数据源实现(提交链路缓存实例,与登录桥/提交流程共享登录态) -->
        <authPlatformSourceProvider implementation="com.codequest.ui.toolwindow.SubmissionAuthPlatformSourceProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- WP11:本地资源/数据 HTTP 服务,随项目启动/关闭 -->
        <projectService serviceImplementation="com.codequest.infra.messaging.CodeQuestHttpServerService"/>
        <postStartupActivity implementation="com.codequest.infra.messaging.CqHttpServerStartupActivity"/>

        <!-- WP20:题面工具窗口导航(nav:openProblem 桥消息 → 打开题目) -->
        <projectService serviceImplementation="com.codequest.ui.toolwindow.ProblemViewNavigator"/>
        <!-- 1.6.0:启动恢复上次打开的题目(题面会话恢复,HTTP 服务就绪后触发) -->
        <postStartupActivity implementation="com.codequest.ui.toolwindow.ProblemViewRestoreStartupActivity"/>
        <!-- 1.5.0:右窗(题面)三 tab 导航——开刷联动/提交完成/云端测试结果定向 -->
        <projectService serviceImplementation="com.codequest.ui.toolwindow.ProblemViewTabNavigator"/>

        <!-- WP15:设置持久化 + 数据库管理(项目级服务,随项目启动/关闭) -->
        <projectService serviceImplementation="com.codequest.infra.settings.CodeQuestSettings"/>
        <projectService serviceImplementation="com.codequest.infra.db.DatabaseManager"/>
        <postStartupActivity implementation="com.codequest.infra.db.DatabaseManagerStartupActivity"/>
        <projectConfigurable id="codequest.settings"
                             groupId="tools"
                             bundle="messages.PluginBundle"
                             key="settings.displayName"
                             instance="com.codequest.ui.settings.CodeQuestSettingsConfigurable"/>

        <!-- WP11:工具窗口壳 -->
        <toolWindow id="CodeQuest"
                    factoryClass="com.codequest.ui.toolwindow.CodeQuestToolWindowFactory"
                    anchor="left"
                    icon="AllIcons.Toolwindows.ToolWindowProject"/>
        <toolWindow id="CodeQuest Problem View"
                    factoryClass="com.codequest.ui.toolwindow.ProblemViewToolWindowFactory"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowProject"/>

        <!-- WP21:提交结果通知组(AC 绿/失败红气球) -->
        <notificationGroup id="codequest.submissions" displayType="BALLOON"/>
        <!-- WP23:竞赛提醒通知组 -->
        <notificationGroup id="codequest.contests" displayType="BALLOON"/>

        <!-- WP23:竞赛提醒后台调度(周期 findDue → 通知 → markNotified) -->
        <projectService serviceImplementation="com.codequest.ui.contest.ContestReminderScheduler"/>
        <postStartupActivity implementation="com.codequest.ui.contest.ContestReminderSchedulerStartupActivity"/>

        <!-- WP55:编辑器浮动工具栏(挑战工作区文件三键:修改测试用例/提交测试/提交) -->
        <editorFloatingToolbarProvider implementation="com.codequest.ui.challenge.ChallengeFloatingToolbarProvider"/>
    </extensions>

    <actions>
        <!-- WP55:挑战文件浮动工具栏组(editorFloatingToolbarProvider 消费;
             provider 只放行挑战工作区文件,组内各 action 再做平台能力/登录态 update 门控) -->
        <group id="CodeQuest.ChallengeEditor.FloatingToolbar" popup="false">
            <action id="CodeQuest.ChallengeEditor.EditTestCases"
                    class="com.codequest.ui.challenge.EditTestCasesAction"/>
            <action id="CodeQuest.ChallengeEditor.RunCloudTest"
                    class="com.codequest.ui.challenge.RunCloudTestAction"/>
        </group>
        <!-- WP21:编辑器提交 action(右键菜单;区域标记代码 → SPI submit → 轮询 → 落库);
             WP55:同 action 并入浮动工具栏三键之「提交」(saveDocument → submitFile) -->
        <action id="CodeQuest.SubmitToOj"
                class="com.codequest.ui.submission.SubmitToOjAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="CodeQuest.ChallengeEditor.FloatingToolbar" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
