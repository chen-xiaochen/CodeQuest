<idea-plugin>
    <id>com.codequest</id>
    <name>CodeQuest</name>
    <vendor>CodeQuest Team</vendor>
    <description><![CDATA[
    CodeQuest is a competitive programming assistant for JetBrains IDEs.
    Query problems, browse statements, submit solutions and track statistics
    across LeetCode, LeetCode CN, CodeForces, AtCoder, Luogu and HackerRank.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- 2026.2 起 JCEF 从 IntelliJ Platform 拆为独立模块(发行版 plugins/jcef-plugin,
         <id>com.intellij.modules.jcef</id>,已实测);未声明会导致运行时 NoClassDefFoundError -->
    <depends>com.intellij.modules.jcef</depends>

    <idea-version since-build="262"/>

    <extensions defaultExtensionNs="com.intellij">
        <!-- WP11:本地资源/数据 HTTP 服务,随项目启动/关闭 -->
        <projectService serviceImplementation="com.codequest.infra.messaging.CodeQuestHttpServerService"/>
        <postStartupActivity implementation="com.codequest.infra.messaging.CqHttpServerStartupActivity"/>

        <!-- WP15:设置持久化 + 数据库管理(项目级服务,随项目启动/关闭) -->
        <projectService serviceImplementation="com.codequest.infra.settings.CodeQuestSettings"/>
        <projectService serviceImplementation="com.codequest.infra.db.DatabaseManager"/>
        <postStartupActivity implementation="com.codequest.infra.db.DatabaseManagerStartupActivity"/>
        <projectConfigurable id="codequest.settings"
                             groupId="tools"
                             bundle="messages.PluginBundle"
                             key="settings.displayName"
                             instance="com.codequest.ui.settings.CodeQuestSettingsConfigurable"/>

        <!-- WP11:工具窗口壳 -->
        <toolWindow id="CodeQuest"
                    factoryClass="com.codequest.ui.toolwindow.CodeQuestToolWindowFactory"
                    anchor="left"
                    icon="AllIcons.Toolwindows.ToolWindowProject"/>
        <toolWindow id="CodeQuest Problem View"
                    factoryClass="com.codequest.ui.toolwindow.ProblemViewToolWindowFactory"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowProject"/>
        <toolWindow id="CodeQuest Submissions"
                    factoryClass="com.codequest.ui.toolwindow.SubmissionsToolWindowFactory"
                    anchor="bottom"
                    icon="AllIcons.Toolwindows.ToolWindowProject"/>
    </extensions>
</idea-plugin>
